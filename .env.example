# Local Postgres (see db/local-dev/README.md) or a real Supabase project's
# connection string, scoped to the RLS-respecting `authenticated` role.
DATABASE_URL=

# Admin/superuser connection — BYPASSES RLS ENTIRELY. In real Supabase this
# maps to the service_role connection. Used ONLY by src/lib/auth/authService.ts
# (signup/login, which happen before a session exists) and integration test
# fixtures. NEVER expose this to the client, NEVER use it for ordinary
# business-data queries — see SECURITY.md.
ADMIN_DATABASE_URL=

# Session cookie signing secret — 32+ characters. Generate with:
#   openssl rand -base64 32
# Rotating this invalidates every existing session (forces re-login).
AUTH_SESSION_SECRET=

# Supabase (create a project at https://supabase.com, then fill these in —
# this REPLACES the local auth stand-in above; see ARCHITECTURE.md
# "Authentication" for the swap-over plan)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server-only, NEVER expose to the client/browser

# AI / OCR provider — required to replace MockAiProvider (src/lib/ai/provider.ts)
ANTHROPIC_API_KEY=

# Billing provider — required to replace the mock subscription adapter
BILLING_PROVIDER_SECRET_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
